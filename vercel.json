{
  "version": 1,
  "rewrites": [
    {
      "source": "/generate-text",
      "destination": "app.py"
    },
    {
      "source": "/humanize",
      "destination": "app.py"
    },
    {
      "source": "/correct",
      "destination": "app.py"
    },
    {
      "source": "/",
      "destination": "index.html"
    },
    {
      "source": "/(.*)",
      "destination": "index.html"
    }
  ]
}